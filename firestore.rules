rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is the customer owner
    function isCustomer(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Customer Profiles:
    // Customers can read, create, and update only their own profile
    match /customers/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow create: if isAuthenticated() && request.auth.uid == uid 
                    && request.resource.data.role == "customer";
      allow update: if isAuthenticated() && request.auth.uid == uid;
      allow delete: if false; // Profiles cannot be deleted directly
    }

    // Labour Profiles:
    // Any authenticated user/customer can read active labours for discovery.
    // Labours cannot be modified or created by customers.
    match /labours/{labourId} {
      allow read: if isAuthenticated();
      allow write: if false; // Restricted to labour app or admin backend
    }

    // Bookings:
    // Customers can create bookings where customerId matches their auth UID.
    // Customers can read only bookings where customerId == auth UID.
    // Customers cannot modify status directly to accepted/rejected/completed.
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && resource.data.customerId == request.auth.uid;
      
      allow create: if isAuthenticated() 
                    && request.resource.data.customerId == request.auth.uid
                    && request.resource.data.status == "pending";
                    
      allow update: if isAuthenticated() 
                    && resource.data.customerId == request.auth.uid
                    // Customer may only cancel their own pending booking
                    && request.resource.data.customerId == request.auth.uid
                    && (
                      (resource.data.status == "pending" && request.resource.data.status == "cancelled")
                      || (request.resource.data.status == resource.data.status)
                    );
                    
      allow delete: if false;
    }
  }
}
